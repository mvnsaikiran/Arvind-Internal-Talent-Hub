rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny - Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Auth tokens NEVER contain custom claims. Explicitly look up roles.
    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        (request.auth.token.email == 'mvnsaikiran123@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidSkill(data) {
      return data.keys().hasAll(['name', 'category', 'description', 'createdAt']) &&
             data.keys().size() <= 7 &&
             data.name is string && data.name.size() <= 100 &&
             data.category is string && data.category.size() <= 50 &&
             data.description is string && data.description.size() <= 1000 &&
             data.createdAt == request.time;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt']) &&
             data.keys().size() <= 25 &&
             data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.createdAt == request.time &&
             (!data.keys().hasAny(['isAdmin']) || data.isAdmin is bool);
    }

    function isValidPost(data) {
      return data.keys().hasAll(['userId', 'type', 'skill', 'status', 'createdAt']) &&
             data.keys().size() <= 12 &&
             data.userId == request.auth.uid &&
             data.type in ['request', 'offer'] &&
             data.skill is string && data.skill.size() <= 100 &&
             data.status in ['active', 'closed'] &&
             data.createdAt == request.time;
    }

    function isValidPairing(data) {
      return data.keys().hasAll(['mentorId', 'menteeId', 'skill', 'status', 'startDate']) &&
             data.keys().size() <= 15 &&
             (data.mentorId == request.auth.uid || data.menteeId == request.auth.uid) &&
             data.mentorId != data.menteeId &&
             data.skill is string && data.skill.size() <= 100 &&
             data.status in ['pending', 'active', 'completed', 'cancelled'] &&
             data.startDate == request.time;
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['pairingId', 'menteeId', 'mentorId', 'rating', 'createdAt']) &&
             data.keys().size() <= 9 &&
             data.menteeId == request.auth.uid &&
             data.rating >= 1 && data.rating <= 5 &&
             data.createdAt == request.time;
    }

    function isValidEndorsement(data) {
      return data.keys().hasAll(['fromUserId', 'fromUserName', 'toUserId', 'skillName', 'createdAt']) &&
             data.keys().size() <= 9 &&
             data.fromUserId == request.auth.uid &&
             data.fromUserId != data.toUserId &&
             data.skillName is string && data.skillName.size() <= 100 &&
             data.createdAt == request.time;
    }

    function isValidLearningResource(data) {
      return data.keys().hasAll(['title', 'provider', 'url', 'createdAt']) &&
             data.keys().size() <= 12 &&
             data.title is string && data.title.size() <= 200 &&
             data.provider in ['LinkedIn Learning', 'Coursera', 'Pluralsight', 'Internal'] &&
             data.url is string && data.url.size() <= 1000 &&
             data.createdAt == request.time;
    }

    function isValidGig(data) {
      return data.keys().hasAll(['title', 'department', 'description', 'status', 'createdAt']) &&
             data.keys().size() <= 15 &&
             data.title is string && data.title.size() <= 200 &&
             data.department is string && data.department.size() <= 100 &&
             data.status in ['open', 'filled', 'completed'] &&
             data.createdAt == request.time;
    }

    function isValidAssessment(data) {
      return data.keys().hasAll(['userId', 'skillName', 'score', 'provider', 'passed', 'verifiedAt']) &&
             data.keys().size() <= 10 &&
             data.userId == request.auth.uid &&
             data.skillName is string && data.skillName.size() <= 100 &&
             data.verifiedAt == request.time;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                      isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'title', 'department', 'bio', 
          'aspirations', 'skillsExpert', 'skillsInterested', 'isMentor', 
          'points', 'level', 'badges', 'isAdmin', 'verifiedSkills', 'managerId'
        ]) &&
        (
          !incoming().diff(existing()).affectedKeys().hasAny(['isAdmin']) ||
          incoming().isAdmin == existing().isAdmin ||
          (request.auth.token.email == 'mvnsaikiran123@gmail.com' && request.auth.token.email_verified == true)
        )
      );
    }

    // 2. Skills Collection
    match /skills/{skillId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidSkill(incoming());
      allow delete: if isAdmin();
    }

    // 3. Resources Collection (Enterprise Extension)
    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidLearningResource(incoming());
      allow delete: if isAdmin();
    }

    // 4. Gigs Collection (Enterprise Extension)
    match /gigs/{gigId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && isValidGig(incoming());
      allow update: if (isAdmin() || isOwner(existing().postedBy)) && 
                       isValidGig(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'description', 'title', 'skillsRequired']);
      allow delete: if isAdmin() || isOwner(existing().postedBy);
    }

    // 5. Assessments Collection (Enterprise Extension)
    match /assessments/{assessmentId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidAssessment(incoming());
    }

    // 6. Posts Collection
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidPost(incoming());
      allow update: if isOwner(existing().userId) && 
                       isValidPost(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'description', 'skill']);
      allow delete: if isOwner(existing().userId);
    }

    // 7. Pairings Collection
    match /pairings/{pairingId} {
      allow read: if isSignedIn() && (existing().mentorId == request.auth.uid || existing().menteeId == request.auth.uid);
      allow create: if isSignedIn() && isValidPairing(incoming());
      allow update: if (existing().mentorId == request.auth.uid || existing().menteeId == request.auth.uid) &&
                       isValidPairing(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastMeetingDate', 'notes', 'progress', 'milestones']);
    }

    // 8. Feedback Collection
    match /feedback/{feedbackId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidFeedback(incoming());
    }

    // 9. Endorsements Collection
    match /endorsements/{endorsementId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidEndorsement(incoming());
      allow delete: if isOwner(existing().fromUserId);
    }
  }
}
